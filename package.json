{
  "name": "bc-ledger-desktop",
  "private": true,
  "version": "0.3.0",
  "description": "Desktop BC ledger tool for G/L account 4092",
  "main": "electron/main.js",
  "scripts": {
    "report": "node src/report-4092.js",
    "start": "electron .",
    "build:config": "node scripts/generate-embedded-config.js",
    "dist": "npm run build:config && electron-builder --win portable"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.onetech.bcledgerdesktop",
    "productName": "BC Ledger Desktop",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "portable"
      ]
    }
  }
}
